# ===== Nguồn AI — app dùng lần lượt, nguồn lỗi/hết tiền thì tự chuyển sang nguồn sau =====
# Thứ tự: các project Vertex trước, rồi các key AI Studio.

# Vertex AI (credit Google Cloud). Nhiều project cách nhau bằng dấu phẩy.
#  - "projA"               → dùng đăng nhập của máy (gcloud auth application-default login)
#  - "projB@C:\keys\b.json" → dùng file khoá service account riêng (tài khoản khác)
# GOOGLE_CLOUD_PROJECT=projA,projB@C:\keys\b.json
# GOOGLE_CLOUD_LOCATION=global
# VEO_LOCATION=us-central1

# Google AI Studio (trả trước). Nhiều key cách nhau bằng dấu phẩy.
GEMINI_API_KEY=

# Tuỳ chọn: đổi model
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# VEO_MODEL=veo-3.1-lite-generate-001   (mặc định veo-3.1-generate-001; tên -001 tự đổi sang -preview cho key AI Studio)
